# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# WooCommerce store
WOO_STORE_URL=https://your-store.com
WOO_CONSUMER_KEY=ck_your_consumer_key
WOO_CONSUMER_SECRET=cs_your_consumer_secret

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Redis cache (optional — in-memory fallback used when empty)
REDIS_URL=redis://localhost:6379

# Bot identity
BOT_NAME=ShopBot
WELCOME_MESSAGE=Hi! 👋 I'm your shopping assistant. How can I help you today?

# CORS — comma-separated list of allowed origins (use * for open access)
ALLOWED_ORIGINS=https://your-store.com
